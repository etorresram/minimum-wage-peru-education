    family-names: "Torres Ramírez"
    email: etorresram@gmail.com
    affiliation: "Pontificia Universidad Católica del Perú"
    orcid: "https://orcid.org/0009-0001-0450-8616"
version: "1.0.0"
date-released: "2026-07-01"
license: MIT
repository-code: "https://github.com/etorresram/minimum-wage-peru-education"
keywords:
  - minimum wage
  - informality
  - education
  - difference-in-differences
  - Peru
  - ENAHO
  - labor economics
references:
